# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# @username канала или числовой id (-100...). Бот должен быть админом канала с правом публикации
CHANNEL_ID=@my_channel

# Как часто проверять ленты (минуты)
POLL_MINUTES=10
# Максимум постов за один проход (чтобы не спамить)
# Не постить новости старше N часов
MAX_AGE_HOURS=16
# Подпись внизу поста (HTML). Можно оставить пустой
FOOTER=⚽ <a href="https://t.me/my_channel">Nosso canal</a>
# Постить ли без картинки, если её не нашли (1/0)
POST_WITHOUT_IMAGE=0

# Ключ OpenAI (platform.openai.com) для рерайта; без него посты идут без перефразирования
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
